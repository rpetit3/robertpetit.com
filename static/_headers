# Cloudflare Pages applies these to static assets. Content-Type cannot be set
# here, so .xml and .webmanifest keep the MIME types Pages derives from the
# extension.
/*
  Access-Control-Allow-Origin: *
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://img.shields.io https://zenodo.org; font-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://*.google-analytics.com https://*.googletagmanager.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; report-uri /csp-report